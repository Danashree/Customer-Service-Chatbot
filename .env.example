# ==============================================================================
# Customer Service Bot — Environment Configuration Template
# Copy this file to .env and insert your real Google API key.
# ==============================================================================

# Google Gemini API Key (Obtain from https://aistudio.google.com)
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini Model Name (gemini-3.5-flash-lite is recommended)
GEMINI_MODEL=gemini-3.5-flash-lite

# Server Configuration (Optional)
HOST=127.0.0.1
PORT=8000
